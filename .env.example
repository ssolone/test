# =========================================================
# Product Sourcing Automation - Environment Variables
# Copy this file to .env and fill in your credentials
# =========================================================

# --- Naver DataLab (검색량 분석) ---
# https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Naver Smart Store Commerce API (상품 등록) ---
# https://developer-smartstore.naver.com/
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=

# --- AliExpress Affiliate API ---
# https://portals.aliexpress.com/
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# --- Amazon Product Advertising API v5 ---
# https://affiliate-program.amazon.com/assoc_credentials/home
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=         # e.g. mystore-20
AMAZON_REGION=us-east-1
AMAZON_MARKETPLACE=www.amazon.com

# --- eBay Finding API ---
# https://developer.ebay.com/
EBAY_APP_ID=

# --- Claude / Anthropic API (번역 + 키워드 분석) ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Optional Overrides ---
USD_TO_KRW=1350
MARKUP_MULTIPLIER=2.5
MIN_TREND_SCORE=30
MAX_PRODUCTS_TO_LIST=20
MIN_MARGIN_PERCENT=30
TOP_KEYWORDS_PER_CATEGORY=5
TOP_PRODUCTS_PER_KEYWORD=3
